{
  "name": "broway-adventures",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "pnpm check && next build",
    "start": "next start",
    "lint": "eslint",
    "check": "pnpm check:tokens && pnpm check:current && pnpm check:marca && pnpm check:deps && pnpm test",
    "check:tokens": "node scripts/check-font-size-tokens.mjs",
    "check:current": "node scripts/check-current-length.mjs",
    "check:marca": "node scripts/check-marca.mjs",
    "check:deps": "if [ -d src ]; then depcruise --config .dependency-cruiser.mjs src; fi",
    "check:marca": "node scripts/check-marca.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "16.3.0",
    "next-intl": "^4.13.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.1",
    "dependency-cruiser": "^18.3.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@10.34.3",
  "engines": {
    "node": ">=24.14.1 <25"
  }
}
